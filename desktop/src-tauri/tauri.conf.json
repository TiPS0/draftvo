{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "draftvo",
  "version": "0.1.0",
  "identifier": "com.draftvo.desktop",
  "build": {
    "frontendDist": "../../frontend/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter backend dev & pnpm --filter frontend dev",
    "beforeBuildCommand": "TAURI_BUILD=true pnpm --filter frontend build"
  },
  "app": {
    "windows": [
      {
        "title": "Draftvo",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
